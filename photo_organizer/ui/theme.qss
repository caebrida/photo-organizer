/* Tema "Estúdio Pro". @NOME é trocado pelas cores de theme.py. */

* {
    font-family: "@FONT_UI";
    font-size: 9pt;
    color: @TEXT;
    outline: none;
}

QMainWindow, #Central, QDialog {
    background: @BG;
}

QMenuBar {
    background: @BG;
    padding: 2px 6px;
}
QMenuBar::item {
    padding: 4px 8px;
    color: @MUTED;
    background: transparent;
}
QMenuBar::item:selected {
    color: @TEXT;
    background: @CARD;
    border-radius: 4px;
}
QMenu {
    background: @PANEL;
    border: 1px solid @BORDER;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: @CARD;
}
QMenu::separator {
    height: 1px;
    background: @BORDER;
    margin: 4px 6px;
}

/* --- Barra superior ------------------------------------------------------------ */

#TopBar {
    background: @BG;
    border-bottom: 1px solid @BORDER;
}

#PathPill {
    background: @PANEL;
    border: 1px solid @BORDER;
    border-radius: 6px;
    text-align: left;
    padding: 0;
}
#PathPill:hover {
    border-color: #444444;
    background: @CARD;
}
#PillCaption {
    color: @MUTED;
    font-size: 7pt;
    font-weight: 600;
    letter-spacing: 1px;
}
#PillPath {
    font-family: @FONT_MONO;
    font-size: 9pt;
}

#Segment {
    background: @PANEL;
    border: 1px solid @BORDER;
    border-radius: 6px;
}
#SegmentButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    color: @MUTED;
}
#SegmentButton:checked {
    background: @CARD;
    color: @TEXT;
    font-weight: 600;
}
#SegmentButton:hover:!checked {
    color: @TEXT;
}
#CountBadge {
    background: @RED;
    color: white;
    border-radius: 7px;
    padding: 0 5px;
    font-size: 7pt;
    font-weight: 700;
}

QPushButton {
    background: @CARD;
    border: 1px solid @BORDER;
    border-radius: 6px;
    padding: 7px 14px;
}
QPushButton:hover {
    background: @CARD_HOVER;
}
QPushButton:disabled {
    color: @FAINT;
    background: @PANEL;
}
QPushButton#Primary {
    background: @ACCENT;
    border: 1px solid @ACCENT;
    color: @ACCENT_TEXT;
    font-weight: 700;
}
QPushButton#Primary:hover {
    background: #FFB43A;
}
QPushButton#Primary:disabled {
    background: #5A4520;
    border-color: #5A4520;
    color: #8A7550;
}
QPushButton#Secondary {
    font-weight: 600;
    padding: 7px 16px;
}

/* --- Painéis ------------------------------------------------------------------- */

#SidePanel, #Inspector {
    background: @PANEL;
}
#SidePanel {
    border-right: 1px solid @BORDER;
}
#Inspector {
    border-left: 1px solid @BORDER;
}
#SectionTitle {
    color: @MUTED;
    font-size: 7pt;
    font-weight: 700;
    letter-spacing: 1px;
}
#Muted {
    color: @MUTED;
}
#Mono {
    font-family: @FONT_MONO;
    color: @MUTED;
    font-size: 8pt;
}
#Error {
    color: @RED;
}
#Count {
    color: @MUTED;
    font-family: @FONT_MONO;
    font-size: 8pt;
}
#PriorityRow {
    background: @CARD;
    border-radius: 4px;
    padding: 7px 10px;
}
#DestBox {
    background: @BG;
    border: 1px solid @BORDER;
    border-radius: 6px;
}
#DestPath {
    font-family: @FONT_MONO;
    color: @ACCENT;
    font-size: 8pt;
}
#Badge {
    background: #3A2A0E;
    color: @ACCENT;
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 7pt;
    font-weight: 700;
}
#SourceChip {
    color: @GREEN;
    border: 1px solid @GREEN;
    border-radius: 3px;
    padding: 0 4px;
    font-size: 7pt;
    font-weight: 700;
}
#Preview {
    background: @BG;
    border-radius: 6px;
}

QLineEdit, QComboBox {
    background: @BG;
    border: 1px solid @BORDER;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: @ACCENT;
    selection-color: @ACCENT_TEXT;
}
QLineEdit:focus, QComboBox:focus {
    border-color: @ACCENT;
}
QLineEdit#PatternEdit {
    font-family: @FONT_MONO;
    font-size: 10pt;
    color: @ACCENT;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background: @PANEL;
    border: 1px solid @BORDER;
    selection-background-color: @CARD;
}

QCheckBox, QRadioButton {
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    background: @BG;
}
QCheckBox::indicator {
    border-radius: 3px;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: @ACCENT;
    border-color: @ACCENT;
}
QCheckBox::indicator:checked {
    image: url(@CHECK_ICON);
}
QRadioButton::indicator:checked {
    background: @BG;
    border: 4px solid @ACCENT;
    width: 8px;
    height: 8px;
}
QCheckBox::indicator:disabled {
    border-color: #333333;
    background: @PANEL;
}
QCheckBox#Toggle::indicator {
    width: 30px;
    height: 16px;
    border-radius: 8px;
    border: none;
    background: #444444;
}
QCheckBox#Toggle::indicator:checked {
    background: @ACCENT;
    image: none;
}

/* --- Centro --------------------------------------------------------------------- */

#Center {
    background: @BG;
}
#BigCount {
    font-size: 13pt;
    font-weight: 700;
}
#FilterChip {
    background: transparent;
    border: 1px solid @BORDER;
    border-radius: 11px;
    padding: 3px 11px;
    font-size: 8pt;
}
#FilterChip:checked {
    background: @TEXT;
    color: @BG;
    border-color: @TEXT;
    font-weight: 600;
}
#EmptyTitle {
    font-size: 13pt;
    font-weight: 600;
}

QListView, QListWidget {
    background: @BG;
    border: none;
}
QListWidget::item {
    padding: 8px;
    border-radius: 6px;
}
QListWidget::item:selected {
    background: @CARD;
    color: @TEXT;
}

QTableWidget {
    background: @BG;
    alternate-background-color: @PANEL;
    border: none;
    gridline-color: transparent;
    selection-background-color: @CARD;
    selection-color: @TEXT;
}
QTableWidget::item {
    padding: 0 6px;
}
QTableWidget::item:selected {
    background: @CARD_HOVER;
    color: @TEXT;
}
QTableWidget QLineEdit {
    padding: 2px 6px;
    border-radius: 4px;
}
QHeaderView::section {
    background: @PANEL;
    color: @MUTED;
    border: none;
    border-bottom: 1px solid @BORDER;
    padding: 6px 8px;
    font-weight: 600;
}

QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #3A3A3A;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #4A4A4A;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #3A3A3A;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QSplitter::handle {
    background: @BORDER;
}

/* --- Duplicadas ---------------------------------------------------------------- */

#DupCard {
    background: @PANEL;
    border: 1px solid @BORDER;
    border-radius: 8px;
}
#DupCard[keep="true"] {
    border-color: @GREEN;
}
#KeepChip {
    color: @GREEN;
    font-weight: 700;
    font-size: 8pt;
}

/* --- Barra de status ------------------------------------------------------------ */

QStatusBar {
    background: @PANEL;
    border-top: 1px solid @BORDER;
    min-height: 28px;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: @MUTED;
    font-size: 8pt;
}
QStatusBar QLabel#Stats {
    font-family: @FONT_MONO;
}
QProgressBar {
    background: @CARD;
    border: none;
    border-radius: 2px;
    max-height: 4px;
    min-width: 220px;
}
QProgressBar::chunk {
    background: @ACCENT;
    border-radius: 2px;
}
QPushButton#Link {
    background: transparent;
    border: none;
    color: @ACCENT;
    padding: 2px 6px;
}

QToolTip {
    background: @PANEL;
    color: @TEXT;
    border: 1px solid @BORDER;
    padding: 6px;
}
QMessageBox QLabel {
    color: @TEXT;
}
